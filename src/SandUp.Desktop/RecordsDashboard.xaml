<UserControl x:Class="SandUp.Desktop.RecordsDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:SandUp.Desktop">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{x:Static ui:UiTheme.Surface}"/>
            <Setter Property="BorderBrush" Value="{x:Static ui:UiTheme.Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{x:Static ui:UiTheme.Text}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="HeroLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{x:Static ui:UiTheme.Muted}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="HeroValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{x:Static ui:UiTheme.Text}"/>
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,5,5,0"/>
        </Style>
        <Style x:Key="AverageValue" TargetType="TextBlock" BasedOn="{StaticResource HeroValue}">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Margin" Value="0,3,5,0"/>
        </Style>
        <Style x:Key="RangeOption" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{x:Static ui:UiTheme.Muted}"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chip" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{x:Static ui:UiTheme.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{x:Static ui:UiTheme.Rest}"/>
                                <Setter Property="Foreground" Value="{x:Static ui:UiTheme.Text}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{x:Static ui:UiTheme.Green}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChartDay" TargetType="RadioButton">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Cell" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="5" Margin="1,0">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cell" Property="Background" Value="{x:Static ui:UiTheme.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Cell" Property="Background" Value="{x:Static ui:UiTheme.Work}"/>
                                <Setter TargetName="Cell" Property="BorderBrush" Value="{x:Static ui:UiTheme.Blue}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Cell" Property="BorderBrush" Value="{x:Static ui:UiTheme.Green}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <Border Style="{StaticResource Card}" Background="{x:Static ui:UiTheme.Work}" BorderThickness="0">
            <StackPanel>
                <TextBlock x:Name="OverviewDate" Style="{StaticResource HeroLabel}" Margin="0,0,0,12"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="工作时长" Style="{StaticResource HeroLabel}"/>
                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                            <TextBlock x:Name="WorkTotal" Style="{StaticResource HeroValue}"/>
                        </Viewbox>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="休息时长" Style="{StaticResource HeroLabel}"/>
                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                            <TextBlock x:Name="RestTotal" Style="{StaticResource HeroValue}" Foreground="{x:Static ui:UiTheme.Green}"/>
                        </Viewbox>
                    </StackPanel>
                    <StackPanel Grid.Column="2" ToolTip="按轮次结束日期统计">
                        <TextBlock Text="完成轮次" Style="{StaticResource HeroLabel}"/>
                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                            <TextBlock x:Name="CompletedTotal" Style="{StaticResource HeroValue}"/>
                        </Viewbox>
                    </StackPanel>
                </Grid>
                <Border Height="1" Background="{x:Static ui:UiTheme.Line}" Margin="0,13,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel x:Name="WorkAverageGroup">
                        <TextBlock Text="每轮平均工作" Style="{StaticResource HeroLabel}"/>
                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                            <TextBlock x:Name="WorkAverage" Style="{StaticResource AverageValue}"/>
                        </Viewbox>
                    </StackPanel>
                    <StackPanel x:Name="RestAverageGroup" Grid.Column="1">
                        <TextBlock Text="每轮平均休息" Style="{StaticResource HeroLabel}"/>
                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                            <TextBlock x:Name="RestAverage" Style="{StaticResource AverageValue}" Foreground="{x:Static ui:UiTheme.Green}"/>
                        </Viewbox>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel Margin="0,0,0,11">
                    <Border DockPanel.Dock="Right" Background="{x:Static ui:UiTheme.Canvas}" CornerRadius="10" Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="SevenDays" Content="7 天" AutomationProperties.Name="最近 7 天"
                                         Style="{StaticResource RangeOption}" IsChecked="True"/>
                            <RadioButton x:Name="ThirtyDays" Content="30 天" AutomationProperties.Name="最近 30 天"
                                         Style="{StaticResource RangeOption}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="工作与休息" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock x:Name="TrendPeriod" DockPanel.Dock="Right" Foreground="{x:Static ui:UiTheme.Muted}" FontSize="12"/>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="9" Height="9" CornerRadius="3" Background="{x:Static ui:UiTheme.Blue}" Margin="0,0,5,0"/>
                        <TextBlock Text="工作" Foreground="{x:Static ui:UiTheme.Muted}" FontSize="12" Margin="0,0,12,0"/>
                        <Border Width="9" Height="9" CornerRadius="3" Background="{x:Static ui:UiTheme.Green}" Margin="0,0,5,0"/>
                        <TextBlock Text="休息" Foreground="{x:Static ui:UiTheme.Muted}" FontSize="12"/>
                    </StackPanel>
                </DockPanel>
                <Grid Height="130">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="31"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid Height="102" VerticalAlignment="Top" TextElement.Foreground="{x:Static ui:UiTheme.Muted}" TextElement.FontSize="10">
                        <TextBlock x:Name="AxisMax" VerticalAlignment="Top"/>
                        <TextBlock x:Name="AxisMid" VerticalAlignment="Center"/>
                        <TextBlock Text="0" VerticalAlignment="Bottom"/>
                    </Grid>
                    <Grid Grid.Column="1" Height="99" Margin="0,4,0,0" VerticalAlignment="Top" IsHitTestVisible="False">
                        <Border Height="1" Background="{x:Static ui:UiTheme.Line}" VerticalAlignment="Top"/>
                        <Border Height="1" Background="{x:Static ui:UiTheme.Line}" VerticalAlignment="Center"/>
                        <Border Height="1" Background="{x:Static ui:UiTheme.Line}" VerticalAlignment="Bottom"/>
                    </Grid>
                    <UniformGrid x:Name="ChartDays" Grid.Column="1" Rows="1"/>
                    <Grid x:Name="ChartLabels" Grid.Column="1" VerticalAlignment="Bottom" Height="26" IsHitTestVisible="False"/>
                    <TextBlock x:Name="ChartMessage" Grid.Column="1" IsHitTestVisible="False" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0,6,20"
                               Background="{x:Static ui:UiTheme.Surface}" Padding="5" Foreground="{x:Static ui:UiTheme.Muted}"/>
                </Grid>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel Margin="0,0,0,12">
                    <DatePicker x:Name="SelectedDate" DockPanel.Dock="Right" Width="135"
                                AutomationProperties.Name="选择明细日期"/>
                    <TextBlock Text="当日明细" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock x:Name="DayDurations" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{x:Static ui:UiTheme.Text}" Margin="0,0,0,4"/>
                <TextBlock x:Name="DayOutcomes" FontSize="12" TextWrapping="Wrap" Foreground="{x:Static ui:UiTheme.Muted}"/>
                <TextBlock x:Name="DayAverages" FontSize="12" TextWrapping="Wrap" Foreground="{x:Static ui:UiTheme.Muted}"
                           Margin="0,3,0,0" ToolTip="按这一天已结束且有对应计时的轮次计算。"/>
                <TextBlock x:Name="DayReminder" FontSize="12" TextWrapping="Wrap" Foreground="{x:Static ui:UiTheme.Muted}"
                           Margin="0,4,0,0" ToolTip="根据工作计时和自报活动计算的休息提示。"/>
                <StackPanel x:Name="ActivityPanel" Visibility="Collapsed" Margin="0,12,0,2">
                    <TextBlock Text="休息活动（自报）" FontSize="13" FontWeight="SemiBold"
                               Foreground="{x:Static ui:UiTheme.Text}" Margin="0,0,0,6"
                               ToolTip="按轮次结束日期统计。每轮自报的每个项目各计 1 次。"/>
                    <UniformGrid x:Name="ActivityCards" Columns="2"/>
                </StackPanel>
                <TextBlock x:Name="DetailMessage" FontSize="12" TextWrapping="Wrap" Foreground="{x:Static ui:UiTheme.Muted}"
                           Margin="0,10,0,0"/>
                <StackPanel x:Name="SessionRows"/>
            </StackPanel>
        </Border>
        <DockPanel Margin="2,0,0,0">
            <StackPanel x:Name="ManagementActions" DockPanel.Dock="Right" Orientation="Horizontal"/>
            <TextBlock Text="记录管理" Style="{StaticResource SectionTitle}" FontSize="14" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock x:Name="Feedback" Foreground="{x:Static ui:UiTheme.Muted}" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" Margin="2,0,0,0"/>
    </StackPanel>
</UserControl>
