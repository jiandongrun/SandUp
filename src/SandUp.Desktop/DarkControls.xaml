<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:SandUp.Desktop"
                    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="DarkDatePicker.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{x:Static ui:UiTheme.Text}"/>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{x:Static ui:UiTheme.Text}"/>
        <Setter Property="Background" Value="{x:Static ui:UiTheme.Raised}"/>
        <Setter Property="BorderBrush" Value="{x:Static ui:UiTheme.Line}"/>
        <Setter Property="Padding" Value="7,4"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{x:Static ui:UiTheme.Text}"/>
        <Setter Property="Background" Value="{x:Static ui:UiTheme.Field}"/>
        <Setter Property="CaretBrush" Value="{x:Static ui:UiTheme.Text}"/>
        <Setter Property="SelectionBrush" Value="{x:Static ui:UiTheme.Selected}"/>
        <Setter Property="BorderBrush" Value="{x:Static ui:UiTheme.Line}"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Field" CornerRadius="4" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Field" Property="BorderBrush" Value="{x:Static ui:UiTheme.Green}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{x:Static ui:UiTheme.Text}"/>
        <Setter Property="Background" Value="{x:Static ui:UiTheme.Raised}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" CornerRadius="4" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AutomationProperties.Name" Value="保存设置">
                            <Setter TargetName="Surface" Property="Background" Value="{x:Static ui:UiTheme.Rest}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{x:Static ui:UiTheme.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{x:Static ui:UiTheme.Selected}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{x:Static ui:UiTheme.Green}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.32"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{x:Static ui:UiTheme.Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Mark" Width="14" Height="14" CornerRadius="3" Margin="0,0,6,0"
                                BorderBrush="{x:Static ui:UiTheme.Muted}" BorderThickness="1" Background="{x:Static ui:UiTheme.Field}" VerticalAlignment="Center">
                            <Path x:Name="Tick" Data="M2 6 L5 9 L10 3" Stroke="{x:Static ui:UiTheme.Canvas}" StrokeThickness="1.6" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Mark" Property="Background" Value="{x:Static ui:UiTheme.Green}"/>
                            <Setter TargetName="Mark" Property="BorderBrush" Value="{x:Static ui:UiTheme.Green}"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Mark" Property="BorderBrush" Value="{x:Static ui:UiTheme.Blue}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{x:Static ui:UiTheme.Text}"/>
        <Setter Property="Padding" Value="7,4"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Option" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Option" Property="Background" Value="{x:Static ui:UiTheme.Work}"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Option" Property="Background" Value="{x:Static ui:UiTheme.Hover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{x:Static ui:UiTheme.Text}"/>
        <Setter Property="Background" Value="{x:Static ui:UiTheme.Field}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="DropDown" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Border x:Name="Field" IsHitTestVisible="False" Background="{TemplateBinding Background}"
                                CornerRadius="4" BorderThickness="1" BorderBrush="Transparent" Padding="5,2">
                            <DockPanel>
                                <Path DockPanel.Dock="Right" Data="M0 0 L3 3 L6 0" Stroke="{x:Static ui:UiTheme.Muted}"
                                      StrokeThickness="1" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True">
                            <Border Background="{x:Static ui:UiTheme.Raised}" BorderBrush="{x:Static ui:UiTheme.Line}" BorderThickness="1" CornerRadius="5"
                                    Padding="2" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Field" Property="Background" Value="{x:Static ui:UiTheme.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Field" Property="BorderBrush" Value="{x:Static ui:UiTheme.Green}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="ScrollPage" TargetType="RepeatButton">
        <Border Background="Transparent"/>
    </ControlTemplate>
    <ControlTemplate x:Key="DarkScrollThumb" TargetType="Thumb">
        <Border x:Name="Grip" Background="{x:Static ui:UiTheme.Line}" CornerRadius="3" Margin="3,1"/>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Grip" Property="Background" Value="{x:Static ui:UiTheme.Muted}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style TargetType="ScrollBar">
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="{x:Static ui:UiTheme.Canvas}">
                                <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="{x:Static primitives:ScrollBar.PageUpCommand}" Template="{StaticResource ScrollPage}"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb MinHeight="18" Template="{StaticResource DarkScrollThumb}"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="{x:Static primitives:ScrollBar.PageDownCommand}" Template="{StaticResource ScrollPage}"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{x:Static ui:UiTheme.Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton x:Name="HeaderSite" Content="{TemplateBinding Header}" HorizontalAlignment="Left"
                                      Foreground="{TemplateBinding Foreground}"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Header" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="3" Background="Transparent">
                                        <StackPanel Orientation="Horizontal">
                                            <Path x:Name="Arrow" Data="M1,1 L5,5 1,9" Stroke="{x:Static ui:UiTheme.Green}" StrokeThickness="1.4"
                                                  Width="10" Margin="2,0,5,0" VerticalAlignment="Center"/>
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="Data" Value="M1,3 L5,7 9,3"/></Trigger>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Header" Property="Background" Value="{x:Static ui:UiTheme.Hover}"/></Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Header" Property="BorderBrush" Value="{x:Static ui:UiTheme.Green}"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="Details" Visibility="Collapsed" ContentSource="Content"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Details" Property="Visibility" Value="Visible"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FloatingMenuAction" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{x:Static ui:UiTheme.Text}"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="MenuRow" Background="Transparent" CornerRadius="3"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="MenuRow" Property="Background" Value="{x:Static ui:UiTheme.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="MenuRow" Property="Background" Value="{x:Static ui:UiTheme.Hover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FloatingContextMenu" TargetType="ContextMenu">
        <Setter Property="Background" Value="{x:Static ui:UiTheme.Raised}"/>
        <Setter Property="Foreground" Value="{x:Static ui:UiTheme.Text}"/>
        <Setter Property="BorderBrush" Value="{x:Static ui:UiTheme.Line}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource FloatingMenuAction}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border x:Name="MenuPanel" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="5" Padding="3" MinWidth="116">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
