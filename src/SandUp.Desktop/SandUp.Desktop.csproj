<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SandUp.Application\SandUp.Application.csproj" />
    <ProjectReference Include="..\SandUp.Infrastructure\SandUp.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>SandUp</AssemblyName>
    <AssemblyTitle>SandUp · 沙立</AssemblyTitle>
    <Product>SandUp · 沙立</Product>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app-icon.png" />
    <Resource Include="Assets\Fonts\NotoSansSC-Regular.otf" />
    <Resource Include="Assets\Fonts\NotoSansSC-Bold.otf" />
  </ItemGroup>

</Project>
